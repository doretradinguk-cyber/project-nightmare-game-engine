{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Nightmare Asset Pack",
  "type": "object",
  "required": ["id", "version", "type", "installPolicy", "platforms", "dependencies", "assets"],
  "properties": {
    "id": { "type": "string", "pattern": "^pn\\.pack\\.[a-z0-9._-]+$" },
    "version": { "type": "string" },
    "type": { "enum": ["core", "quality", "world", "dlc", "platform"] },
    "installPolicy": { "enum": ["install-time", "optional", "on-demand", "dlc"] },
    "platforms": { "type": "array", "items": { "enum": ["web", "windows", "android"] } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "assets": { "type": "array", "items": {
      "type": "object",
      "required": ["id", "path", "type", "redistributable", "licenceRef"],
      "properties": {
        "id": { "type": "string" },
        "path": { "type": "string" },
        "type": { "enum": ["model", "texture", "material", "audio", "animation", "data", "font", "shader"] },
        "redistributable": { "type": "boolean" },
        "licenceRef": { "type": "string" },
        "sha256": { "type": "string" }
      }
    }}
  }
}